# Server
NODE_ENV=development
PORT=2000
# Interface the API binds to. When HOST is unset the API uses 0.0.0.0 outside
# production and 127.0.0.1 when NODE_ENV=production. In production nginx is the
# only public listener, so keep the API loopback; HOST overrides that default,
# so set it deliberately.
# HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API.
FRONTEND_URL=http://localhost:5173
# Set to 1 only behind a trusted reverse proxy.
TRUST_PROXY=0

# MongoDB (the existing Meridian user schema lives here)
MONGO_URI=mongodb://127.0.0.1:27017/meridian

# Auth: generate with `openssl rand -base64 48`
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=3600000
# Set to false only for local development; production should require a verified email.
REQUIRE_EMAIL_VERIFICATION=true

# Public origin used for uploaded attachment URLs when the API is on another host.
PUBLIC_API_URL=

# Outbound email. Leave disabled to store contact messages without sending mail.
EMAIL_ENABLED=false
EMAIL_PROVIDER=zoho
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=hello@meridianstudios.org
EMAIL_FROM_NAME=Meridian Studios

# Optional CRM bridge. Both must be set for intake forwarding to run.
CRM_INTAKE_URL=
CRM_INTAKE_SECRET=
CRM_TIMEOUT_MS=5000

# The website JWT is signed with JWT_SECRET and can be exchanged at
# meridiancrm /api/v1/auth/website when CRM WEBSITE_JWT_SECRET matches it.
