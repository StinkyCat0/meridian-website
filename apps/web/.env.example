# Empty means same origin: Vite proxies /api in development, nginx proxies it
# in production. Set to an origin (for example https://api.example.com) only
# when the API is hosted separately.
VITE_API_URL=

# Optional link to the staff CRM. Empty hides the link.
VITE_CRM_URL=

# Development-only convenience login. Both values must be set for the dev
# button to render; production builds omit the block because import.meta.env.DEV
# is false. The demo users are created by `npm run seed:demo`.
# VITE_DEV_LOGIN_EMAIL=demo@meridian.studio
# VITE_DEV_LOGIN_PASSWORD=Meridian2026!
